# ============================================
# PONTO FACIAL ENTERPRISE v3.0.0
# Environment Configuration
# ============================================

# ============================================
# 🗄️  ORACLE DATABASE
# ============================================
ORACLE_USER=ponto_user
ORACLE_PASSWORD=SecurePassword123!
ORACLE_CONNECTION_STRING=oracle-host.aws.com:1521/XE
ORACLE_POOL_MAX=10
ORACLE_POOL_MIN=2
ORACLE_POOL_TIMEOUT=3000

# ============================================
# ☁️  AWS CONFIGURATION
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA_YOUR_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY_HERE
AWS_S3_BUCKET=ponto-facial-photos
DYNAMODB_TABLE=ponto-facial-records
AWS_REKOGNITION_CONFIDENCE_THRESHOLD=0.85

# ============================================
# 🔐 SECURITY & AUTH
# ============================================
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
SESSION_SECRET=your_session_secret_key_here
ENCRYPTION_KEY=your_encryption_key_32_chars

# ============================================
# 📱 APP CONFIGURATION
# ============================================
NEXT_PUBLIC_API_URL=https://seu-dominio.com
NEXT_PUBLIC_APP_NAME=Ponto Facial Enterprise
NODE_ENV=production
PORT=3000

# ============================================
# 🎥 CAMERA SETTINGS
# ============================================
NEXT_PUBLIC_CAMERA_WIDTH=1280
NEXT_PUBLIC_CAMERA_HEIGHT=720
NEXT_PUBLIC_MIN_FACE_CONFIDENCE=0.85

# ============================================
# 📧 EMAIL & NOTIFICATIONS
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app
SMTP_FROM=noreply@pontefacial.com

# ============================================
# 📊 MONITORING & LOGGING
# ============================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
LOG_LEVEL=info
ENABLE_CLOUDWATCH_LOGS=true

# ============================================
# 🗄️  DATABASE BACKUP
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * # 2 AM daily
BACKUP_RETENTION_DAYS=30

# ============================================
# 🔒 COMPLIANCE
# ============================================
LGPD_COMPLIANCE_MODE=true
GDPR_COMPLIANCE_MODE=false
DATA_RETENTION_DAYS=90
PHOTO_RETENTION_DAYS=30

# ============================================
# 🚀 FEATURE FLAGS
# ============================================
FEATURE_FACE_RECOGNITION=true
FEATURE_ATTENDANCE_REPORT=true
FEATURE_ADMIN_DASHBOARD=true
FEATURE_BATCH_IMPORT=true
FEATURE_API_WEBHOOK=false

# ============================================
# 🔔 ALERT THRESHOLDS
# ============================================
ALERT_FAILURE_THRESHOLD=0.05  # 5% de falhas
ALERT_CONFIDENCE_THRESHOLD=0.80  # Confiança mínima
ALERT_SYSTEM_UPTIME_THRESHOLD=99.5  # % mínimo

# ============================================
# 📍 TERMINAL/DEVICE SETTINGS
# ============================================
DEVICE_ID=TABLET-TERMINAL-01
DEVICE_NAME=Terminal Entrada Principal
DEVICE_LOCATION=Recepção
DEVICE_TIMEZONE=America/Sao_Paulo

# ============================================
# 🔗 INTEGRATIONS
# ============================================
WEBHOOK_URL_ATTENDANCE=https://seu-webhook.com/attendance
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK
TEAMS_WEBHOOK_URL=https://outlook.webhook.office.com/webhookb2/YOUR/URL

# ============================================
# 📈 ANALYTICS
# ============================================
GOOGLE_ANALYTICS_ID=UA-XXXXX-XX
MIXPANEL_TOKEN=your-mixpanel-token
HOTJAR_ID=your-hotjar-id

# ============================================
# 🧪 TESTING
# ============================================
TEST_MODE=false
TEST_EMPLOYEE_ID=1
TEST_DEVICE_ID=TEST-DEVICE-001

# ============================================
# 🔐 OPTIONAL: AWS COGNITO (para autenticação)
# ============================================
# AWS_COGNITO_USER_POOL_ID=us-east-1_xxxxx
# AWS_COGNITO_CLIENT_ID=xxxxxxxxxxxxx
# AWS_COGNITO_DOMAIN=seu-dominio.auth.us-east-1.amazoncognito.com

# ============================================
# IMPORTANTE - SEGURANÇA
# ============================================
# ⚠️  NUNCA commitar este arquivo em Git!
# ⚠️  Usar ferramentas como AWS Secrets Manager
# ⚠️  Manter backups cifrados em local seguro
# ⚠️  Trocar senhas regularmente (a cada 90 dias)
# ⚠️  Usar .env.local para desenvolvimento local
# ⚠️  Configurar via CI/CD em produção
